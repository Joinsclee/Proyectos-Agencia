# =============================================================================
#  JoinsClee · Comunidad Skool ⇄ GoHighLevel
#  Copia a .env y rellena. NUNCA commitees el .env real.
#  Estas variables las usa scripts/smoke-test.sh en tu máquina; en producción
#  viven como secrets de Supabase (ver README, paso 3).
# =============================================================================

# ── Skool ────────────────────────────────────────────────────────────────────
# Cookies de una sesión de admin del grupo. En skool.com logueado como admin:
# DevTools → Application → Cookies → https://www.skool.com
SKOOL_AUTH_TOKEN=""
SKOOL_CLIENT_ID=""
# Slug del grupo, tal cual aparece en la URL: skool.com/<esto>
SKOOL_GROUP="joinsclee-xxxx"

# ── GoHighLevel ──────────────────────────────────────────────────────────────
# Private Integration Token de AGENCIA (no el de una sub-cuenta).
# Panel de AGENCIA → Settings → Private Integrations → Create.
# Scopes necesarios: users.readonly, users.write, locations.readonly,
#                    locations.write, snapshots.readonly
GHL_AGENCY_PIT=""
# ID de la agencia (companyId). Sale de la URL del panel de agencia,
# o de Settings → Company. Es OBLIGATORIO en /users/search.
GHL_COMPANY_ID=""
# Snapshot con el que se pre-cargan las sub-cuentas del bono. Sin esto, se
# crean vacías.
GHL_SNAPSHOT_ID=""

# ── Slack ────────────────────────────────────────────────────────────────────
# Incoming webhook de un canal PRIVADO (el payload lleva emails de clientes).
# https://api.slack.com/apps → tu app → Incoming Webhooks → Add New Webhook
SLACK_WEBHOOK_URL=""

# ── Panel de admin ───────────────────────────────────────────────────────────
# Token largo y aleatorio. Genéralo con:  openssl rand -hex 32
ADMIN_TOKEN=""
# URL donde publicas panel-comunidad.html (va en el botón de Slack)
ADMIN_PANEL_URL=""
# Origen permitido para CORS. Déjalo en * solo mientras pruebas.
ADMIN_ALLOWED_ORIGIN="*"

# ── Frenos de mano ───────────────────────────────────────────────────────────
# true = detecta y avisa, pero no toca GHL. Déjalo en true 2 semanas.
DRY_RUN="true"
# true = el cron revoca solo, sin humano. Déjalo en false salvo decisión explícita.
AUTO_REVOKE="false"
# Tope de revocaciones automáticas por corrida. Si se supera, no ejecuta ninguna.
MAX_REVOKES_PER_RUN="5"
# Corridas consecutivas sin ver a alguien antes de considerarlo baja.
MISSING_STRIKES="3"
# % de caída de activos que dispara el circuit breaker.
MAX_ACTIVE_DROP_PCT="20"
# Intentar pausar la sub-cuenta vía SaaS API (best-effort, puede dar 401).
TRY_PAUSE_LOCATION="false"
# Tope de sub-cuentas creadas por lote.
MAX_PROVISION_PER_RUN="5"
# Prefijo del nombre de las sub-cuentas creadas.
GHL_LOCATION_PREFIX="JC"

# ── Solo para smoke-test.sh (recursos DESECHABLES) ───────────────────────────
TEST_GHL_USER_ID=""
TEST_GHL_USER_EMAIL=""
TEST_GHL_LOCATION_ID=""
