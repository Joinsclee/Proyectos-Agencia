# Planificador de scraping del Radar — servicio SEPARADO del servidor web.
#
# Va aparte a propósito: el web sirve peticiones y debe reiniciarse rápido y sin
# consecuencias; el planificador arranca navegadores y procesa PDFs de 18 MB. Si
# compartieran contenedor, un scrape pesado dejaría el dashboard sin memoria, y
# escalar el web a dos réplicas duplicaría las corridas.
#
# El calendario vive en Supabase (`radar_cron_jobs`), así que este contenedor es
# desechable: si se reinicia, retoma donde iba.
FROM node:22-slim

WORKDIR /app

# Aquí SÍ hacen falta los navegadores: el scraper de remates entra con sesión.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# poppler-utils: `pdfinfo`, `pdftotext` y `pdftoppm`, que es como leen sus PDFs
# los scrapers de BBVA y AVAL (ver la cabecera de `lib/pdf-pages.ts`, que ya
# declaraba el requisito).
#
# Faltaba, y el síntoma no se parecía a la causa: los dos scrapers morían en
# 3,5 segundos con `pdfinfo: not found` mientras el diagnóstico que circulaba era
# «se queda sin memoria con el PDF de 17,5 MB de AVAL». Ni siquiera llegaban a
# abrirlo. Estuvieron doce días sin traer un solo registro.
#
# Va en su propia capa y antes de `npm ci` para que no se reinstale con cada
# cambio del código.
RUN apt-get update \
 && apt-get install -y --no-install-recommends poppler-utils \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

# Dependencias de sistema que Chromium necesita en la imagen slim.
RUN npx playwright install --with-deps chromium

COPY . .

ENV NODE_ENV=production
ENV TZ=America/Bogota

CMD ["npm", "run", "cron"]
