{
  "name": "radar-mvp",
  "version": "0.1.0",
  "description": "Radar de Oportunidades Inmobiliarias - Sistema CRECE. Scraping cron de bancos colombianos con Firecrawl + motor de comparables.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "scrape:davivienda": "tsx scrapers/CO/davivienda/index.ts",
    "scrape:bancolombia": "tsx scrapers/CO/bancolombia/index.ts",
    "scrape:bbva": "tsx scrapers/CO/bbva/index-v2.ts",
    "scrape:aval": "tsx scrapers/CO/aval/index-v2.ts",
    "scrape:all": "tsx cron/orchestrator.ts",
    "remates:login": "tsx scrapers/CO/rematandobienes/login.ts",
    "remates:recon": "tsx scrapers/CO/rematandobienes/recon.ts",
    "remates:test-parser": "tsx scripts/test-remates-parser.ts",
    "remates:scrape": "tsx scrapers/CO/rematandobienes/index.ts",
    "remates:dashboard": "tsx scripts/build-remates-dashboard.ts",
    "dashboard:unified": "tsx scripts/build-unified-dashboard.ts",
    "serve": "tsx server/index.ts",
    "engine": "tsx engine/run.ts",
    "test:portals": "tsx scripts/test-all-portals.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test engine/*.test.ts lib/*.test.ts server/*.test.ts cron/*.test.ts scrapers/CO/rematandobienes/*.test.ts",
    "test:e2e": "node --import tsx --test e2e/*.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "scrape:fincaraiz": "tsx scrapers/CO/fincaraiz/index.ts",
    "cron": "tsx cron/scheduler.ts",
    "cron:once": "tsx cron/scheduler.ts --once",
    "email:preview": "tsx scripts/preview-alert-email.ts"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
