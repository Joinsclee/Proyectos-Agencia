# =====================================================
#  Radar MVP - Variables de entorno
# =====================================================

# ───── Firecrawl (Free tier OK para validar) ─────
# Obtener en https://www.firecrawl.dev → API Keys
FIRECRAWL_API_KEY=fc-...

# Para self-host futuro: dejar vacío FIRECRAWL_API_URL para usar cloud,
# o setear http://localhost:3002 si corres Firecrawl OSS local.
# FIRECRAWL_API_URL=

# ───── Supabase ─────
# El proyecto se recreó el 20/10/2026 (el anterior, uqlfgnylvnefhyuvtncd, se
# borró tras quedar restringido por cuota). Restaurar: scripts/restaurar-base/.
#
# Una variable presente pero VACÍA cuenta como ausente (lib/env.ts la limpia
# antes de validar), así que se puede crear en blanco y rellenar después sin
# que el servidor deje de arrancar. Estas dos son la excepción: sin ellas no
# arranca, y así debe ser — arrancar sin base significa descubrirlo en la
# primera consulta de un usuario.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# La anon la usa el navegador para el login. No da acceso a datos: las 17
# tablas tienen RLS activado y ninguna política, así que solo lee service_role.
SUPABASE_ANON_KEY=

# Conexión directa a Postgres. La necesitan el restore y el modo demo, no el
# servidor web. Puerto 5432 (session pooler), NO el 6543 que enseña el panel por
# defecto: ese es el transaction pooler, no mantiene sesión y rompe las
# consultas largas. La @ de la contraseña va como %40 porque es una URI.
RADAR_DATABASE_URL=

# ───── OpenAI (análisis IA del servidor — REQUERIDO en producción) ─────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ───── Default config ─────
DEFAULT_COUNTRY_CODE=CO
SCRAPE_LOG_LEVEL=info
# PORT lo inyecta la plataforma (Railway/Render); 8787 por defecto en local.

# ───── Fase 2: remates judiciales (después) ─────
REMATES_USERNAME=
REMATES_PASSWORD=

# ───── Correo (Resend): alertas y recuperación de contraseña ─────
# Sin estas dos, las alertas se guardan pero no se envían y la recuperación de
# contraseña no se ofrece: el código lo informa en vez de fallar
# (emailDeliveryReady() y correoDeRecuperacionDisponible() devuelven false).
#
# El dominio de ALERTS_FROM_EMAIL tiene que estar verificado en Resend, o los
# envíos se rechazan. Un valor mal escrito SÍ impide arrancar, a propósito:
# vacío significa «todavía no», mal escrito significa que alguien se equivocó.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=
ALERTS_CRON_SECRET=

# El enlace de recuperación se construye sobre esto, y la URL resultante debe
# estar en la lista de redirecciones permitidas del proyecto de Supabase
# (Authentication → URL Configuration). Si no está, el enlace del correo llega
# pero al pulsarlo Supabase lo rechaza.
APP_BASE_URL=http://localhost:8787

# ───── Fase 2 comercial: Wompi Sandbox (demo, sin dinero real) ─────
# Crear llaves de PRUEBA en https://comercios.wompi.co/
# El checkout requiere pública + integridad; la activación segura requiere eventos.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Reservada para futuras consultas de transacciones desde el backend.
WOMPI_PRIVATE_KEY=

# ───── Fase 3: motor comparables ─────
FINCARAIZ_API_KEY=

# Activación de demostración del plan de pago (0 = cerrada, 1 = abierta).
# En 1, pulsar el botón del plan de pago concede el acceso completo SIN COBRAR.
# Sirve para enseñar el producto entero antes de tener la pasarela operativa.
# Ponerlo en 0 es el único cambio necesario para cerrarlo, sin desplegar código.
RADAR_DEMO_PLAN=0

# El scraper de remates abre un navegador. En un contenedor no hay pantalla, así
# que en el servicio `radar-cron` esto debe ir en 1.
REMATES_HEADLESS=1
