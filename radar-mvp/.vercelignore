# Lo que NUNCA debe salir de esta maquina.
#
# `vercel deploy` desde la CLI sube el directorio de trabajo, no lo que esta en
# git, asi que los 353 MB de `Backup/` —direcciones reales, URLs de origen,
# correos y contrasenas cifradas de los 45 usuarios— viajarian al despliegue
# aunque .gitignore ya los excluya del repo.
Backup/
.env
.env.*

# Credenciales de sesion de los scrapers.
*.session.json
playwright/.auth/

# Peso muerto: el servidor no importa nada de aqui.
brag-output/
docs/
scripts/
supabase/
**/*.test.ts
**/*.log
.git/
node_modules/
